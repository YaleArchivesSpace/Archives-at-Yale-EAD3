            <scopecontent id="aspace_ad8b2eb5145a7d15f838f8b7ecdc96c5">
               <head>Scope and Contents</head>
               <p>Included in this series are handwritten and printed scores of Sierra's orchestral and chamber music compositions. Published scores include notes and corrections.</p>
            </scopecontent>
            <c altrender="/repositories/6/archival_objects/2630493"
               id="aspace_f528a0f8927d4edd1dfa788db7e09a8d"
               level="file">
               <did>
                  <unittitle>Box 1</unittitle>
                  <container altrender="/repositories/6/top_containers/304217 /locations/9"
